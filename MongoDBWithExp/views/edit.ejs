<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit</title>
</head>
<body>
    <h1>Edit your message</h1>
    <p>This is the chat from <%= chat.from %> to <%= chat.to %></p>
    <form method="POST" action="/chats/<%=chat.id%>?_method=PUT">
        <textarea name="msg" row="5"  col="10"> <%= chat.msg %></textarea>
        <button>Edit</button>
    </form>
</body>
</html>