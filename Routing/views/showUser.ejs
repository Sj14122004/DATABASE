<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All User</title>
    <style>
        table, td, th {
            border: 2px solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>Id</th>
            <th>Email</th>
            <th>Username</th>
        </tr>
        <tr>
            <% for(res of result) {  %>
        <tr>
            <td><%= res.id %></td>
            <td> <%= res.email %></td>
            <td><%= res.username %></td>
            <td>
            <form method="GET" action="/user/<%=res.id %>/edit">
                <button>Edit username</button>
                
            </form>
            <form method="GET" action="/user/<%= res.id%>/delete">
                <button type="submit" >Delete</button>
            </form>
            <form method="GET" action="/user/add">
                <button>add</button>
            </form>
            </td>
        </tr>
  <% } %>
        </tr>
    </table>
</body>
</html>

