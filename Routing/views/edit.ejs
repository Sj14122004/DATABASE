<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit user</title>
</head>
<body>
    <p>Edit your details : <%= a.email %></p>
    <form method = "post" action="/user/<%= a.id %>?_method=PATCH">
        <textarea name="username" id=""><%= a.username %></textarea>
        <input type="password" name = "password" placeholder="enter your password">
        <button>Edit</button>
    </form>
</body>
</html>